SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=monitor@example.com
SMTP_PASSWORD=replace-with-secret
SMTP_FROM_EMAIL=monitor@example.com
SMTP_USE_TLS=true
ALERT_EMAIL=admin@example.com
LOCAL_HEALTH_URL=http://127.0.0.1:8080/health
PUBLIC_HEALTH_URL=https://api.example.com/health
DISK_WARNING_PERCENT=70
DISK_CRITICAL_PERCENT=85
ALERT_REPEAT_SECONDS=21600
