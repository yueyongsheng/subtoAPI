[Unit]
Description=Sub2API production health monitor
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/sub2api-monitor.env
ExecStart=/usr/local/sbin/sub2api-health-monitor
StateDirectory=sub2api-monitor
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sub2api-monitor
