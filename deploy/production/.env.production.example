# Copy to .env on the server. Never commit the real file.

# Fixed images only. Prefer an immutable digest after the first verified pull.
SUB2API_IMAGE=ghcr.io/yueyongsheng/subtoapi:release-v0.1.0
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine

# Application
BIND_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_VALUE
JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
TOTP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# PostgreSQL bootstrap administrator and non-superuser application owner.
POSTGRES_ADMIN_USER=sub2api_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_VALUE
POSTGRES_DB=postgres
SUB2API_DB_USER=sub2api_app
SUB2API_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_VALUE
SUB2API_DB_NAME=sub2api
DATABASE_MAX_OPEN_CONNS=30
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# Redis
REDIS_PASSWORD=REPLACE_WITH_RANDOM_VALUE
REDIS_DB=0
REDIS_POOL_SIZE=128
REDIS_MIN_IDLE_CONNS=10

# Production URL validation. Keep these values unless a reviewed use case needs otherwise.
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=

# Optional provider OAuth settings. Consumer OAuth accounts are not used for paid service.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
UPDATE_PROXY_URL=
