# Replace api.example.com after the domain is provided.
api.example.com {
  encode zstd gzip

  @static path /assets/*
  header @static Cache-Control "public, max-age=31536000, immutable"

  @dynamic not path /assets/*
  header @dynamic Cache-Control "no-store"

  reverse_proxy 127.0.0.1:8080 {
    health_uri /health
    health_interval 30s
    health_timeout 10s
    flush_interval -1
  }

  log {
    output file /var/log/caddy/sub2api-access.log {
      roll_size 50MiB
      roll_keep 10
      roll_keep_for 720h
    }
    format json
  }
}
